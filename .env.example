TALENT_RANKER_DATABASE_URL=postgresql://talent_ranker:talent-ranker-local@localhost:5432/talent_ranker
TALENT_RANKER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TALENT_RANKER_RERANKER_MODEL=BAAI/bge-reranker-base
TALENT_RANKER_RETRIEVAL_LIMIT=300
TALENT_RANKER_RERANK_LIMIT=100
TALENT_RANKER_RRF_K=60
# Set to llm after adding a Qubrid API key; rules remains the offline default.
TALENT_RANKER_CALIBRATION_EXTRACTOR=rules
TALENT_RANKER_CALIBRATION_API_URL=https://platform.qubrid.com/v1/chat/completions
TALENT_RANKER_CALIBRATION_MODEL=deepseek-ai/DeepSeek-V4-Pro
TALENT_RANKER_CALIBRATION_API_KEY=
TALENT_RANKER_CALIBRATION_TIMEOUT_SECONDS=60
TALENT_RANKER_GOOGLE_CREDENTIALS_FILE=secrets/google-client.json
TALENT_RANKER_GOOGLE_TOKEN_FILE=.tokens/drive.json
# Google Web application OAuth client for browser-based Drive connection.
TALENT_RANKER_GOOGLE_WEB_CREDENTIALS_FILE=candidate-screening/secrets/gmail-web-client.json
TALENT_RANKER_GOOGLE_WEB_REDIRECT_URI=http://127.0.0.1:8000/api/sources/drive/oauth/callback
TALENT_RANKER_FRONTEND_BASE_URL=http://127.0.0.1:5173
# SharePoint Online app registration with read access to the client-approved site.
TALENT_RANKER_SHAREPOINT_TENANT_ID=
TALENT_RANKER_SHAREPOINT_CLIENT_ID=
TALENT_RANKER_SHAREPOINT_CLIENT_SECRET=
# Optional for public GitHub API rate limits. Never use a token with private-repo/write access.
TALENT_RANKER_GITHUB_TOKEN=
TALENT_RANKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local-file and Google Drive CLI storage; not required for SharePoint ingestion.
TALENT_RANKER_CANONICAL_STORAGE_BACKEND=s3
TALENT_RANKER_CANONICAL_S3_BUCKET=
TALENT_RANKER_CANONICAL_S3_PREFIX=talent-ranker
# Optional for MinIO or another S3-compatible service:
# TALENT_RANKER_CANONICAL_S3_ENDPOINT_URL=http://localhost:9000
# For local development instead: set backend=filesystem.
TALENT_RANKER_CANONICAL_LOCAL_ROOT=.data/object-storage

# Optional Recruitment Agent. Install the agent extra before enabling.
# Dedicated configuration: calibration credentials are not implicitly reused.
# BASE_URL is the provider API root (e.g. https://provider.example/v1),
# not the /chat/completions endpoint. Verify native tool calling before enabling.
SIEVE_AGENT_ENABLED=false
SIEVE_AGENT_MODEL=
SIEVE_AGENT_API_KEY=
SIEVE_AGENT_BASE_URL=
SIEVE_AGENT_WORKSPACE_ID=demo
# Authenticated actor -> explicitly allowed demo job IDs. Empty denies all.
# This scopes the agent only; existing APIs are not enterprise tenant-isolated.
SIEVE_AGENT_ALLOWED_JOBS_BY_ACTOR={}
SIEVE_AGENT_MAX_MODEL_TURNS=8
SIEVE_AGENT_MAX_TOOL_CALLS=12
SIEVE_AGENT_EXECUTION_TIMEOUT_SECONDS=90
SIEVE_AGENT_MODEL_TIMEOUT_SECONDS=30
SIEVE_AGENT_MAX_RETRIES=1
SIEVE_AGENT_MAX_RECIPIENTS=10
