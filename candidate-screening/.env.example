SCREENING_DATABASE_URL=postgresql://talent_ranker:talent-ranker-local@localhost:5432/talent_ranker
SCREENING_PUBLIC_BASE_URL=http://localhost:8001/screening/invites
SCREENING_INVITE_EXPIRY_HOURS=48
SCREENING_MAX_CAMPAIGN_SIZE=1000
SCREENING_SENDER_BACKEND=fake
SCREENING_SMTP_HOST=
SCREENING_SMTP_PORT=587
SCREENING_SMTP_USERNAME=
SCREENING_SMTP_PASSWORD=
SCREENING_SMTP_FROM_EMAIL=
# To send initial links from a Gmail account through Gmail API OAuth:
# SCREENING_SENDER_BACKEND=gmail_api
SCREENING_GMAIL_SENDER_EMAIL=
SCREENING_GMAIL_CLIENT_SECRETS_FILE=secrets/gmail-desktop-client.json
SCREENING_GMAIL_TOKEN_FILE=.tokens/gmail-sender.json
# JSON map from local bearer tokens to recruiter identities. Replace with your identity adapter in production.
SCREENING_RECRUITER_TOKENS={"local-dev-token":"local-recruiter"}
